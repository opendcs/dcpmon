{
  "name": "dds-http",
  "version": "1.0.0",
  "description": "A JavaScript client for the DCP Data Service HTTP API",
  "author": "OPENDCS,LRGS,Local Readout Ground Station,Data Collection System,Open Source",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HydrologicEngineeringCenter/cwms-data-api-client-javascript"
  },
  "keywords": [
    "openapi-client",
    "opendcs",
    "lrgs",
    "decodes"
  ],
  "license": "MIT License",
  "main": "./generated/dist/index.js",
  "type": "commonjs",
  "exports": {
    ".": "./generated/dist/index.js"
  },
  "typings": "./dist/index.d.ts",
  "scripts": {
    "build": "npm run buildApi && npm run buildDocs",
    "buildApi": "npm run buildSpec && npm run openapi && npm run modPackage && cd cwmsjs && npm run build",
    "buildDocs": "shx mkdir -p ./docs && cd docs && npx typedoc src/index.ts",
    "cleanDocs": "shx mkdir -p ./docs && shx rm -r ./docs",
    "getSpec": "wget https://github.com/opendcs/dcs_standards/blob/propose/dds-over-http/source/dds-http.yaml -O dds-http.yaml",
    "openapi": "./generate.sh"
  },
  "dependencies": {
    "es6-promise": "^4.2.4",
    "shx": "^0.3.4",
    "url-parse": "^1.4.3",
    "whatwg-fetch": "^3.0.0"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.15.3",
    "@types/url-parse": "1.4.4",
    "babel-cli": "^6.26.0",
    "node-jq": "^6.0.1",
    "prettier": "^3.3.3",
    "typedoc": "^0.25.13",
    "typescript": "^4.9.5"
  }
}
